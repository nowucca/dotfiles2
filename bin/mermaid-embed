#!/usr/bin/env node

/**
 * mermaid-embed - Embed mermaid diagram PNGs into markdown
 *
 * Runs mmdc to generate PNG files from mermaid blocks, then inserts
 * image references into the markdown while preserving the source.
 */

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const VERSION = '1.0.0';

// Parse command line arguments
function parseArgs() {
  const args = process.argv.slice(2);
  const options = {
    help: false,
    dryRun: false,
    noBackup: false,
    outputDir: null,
    inputFile: null
  };

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];

    if (arg === '-h' || arg === '--help') {
      options.help = true;
    } else if (arg === '-d' || arg === '--dry-run') {
      options.dryRun = true;
    } else if (arg === '-n' || arg === '--no-backup') {
      options.noBackup = true;
    } else if (arg === '-o' || arg === '--output') {
      options.outputDir = args[++i];
    } else if (!arg.startsWith('-')) {
      options.inputFile = arg;
    } else {
      console.error(`Unknown option: ${arg}`);
      process.exit(1);
    }
  }

  return options;
}

// Display help
function showHelp() {
  console.log(`
mermaid-embed v${VERSION}

USAGE:
  mermaid-embed [OPTIONS] FILE

DESCRIPTION:
  Runs mermaid-cli (mmdc) to generate PNG diagrams from mermaid code blocks,
  then embeds image references into the markdown while preserving source.

OPTIONS:
  -h, --help       Display this help message
  -d, --dry-run    Show what would be changed without modifying files
  -n, --no-backup  Skip creating backup file
  -o, --output DIR Specify output directory for images

EXAMPLES:
  mermaid-embed README.md
  mermaid-embed --dry-run architecture.md
  mermaid-embed --no-backup docs/diagrams.md

DOCUMENTATION:
  For full documentation, see: mermaid-embed.md
  Or run: cat $(dirname $0)/mermaid-embed.md | less

DEPENDENCIES:
  Requires: npm install -g @mermaid-js/mermaid-cli
`);
}

// Check if mmdc is installed
function checkDependencies() {
  try {
    execSync('which mmdc', { stdio: 'ignore' });
    return true;
  } catch (error) {
    return false;
  }
}

// Create timestamped backup
function createBackup(inputFile) {
  const timestamp = new Date().toISOString()
    .replace(/[-:]/g, '')
    .replace(/\.\d+Z$/, '')
    .replace('T', '-');
  const backupFile = `${inputFile}.backup.${timestamp}`;

  fs.copyFileSync(inputFile, backupFile);
  console.log(`✓ Backup created: ${backupFile}`);
  return backupFile;
}

// Run mmdc to generate PNG files
function runMermaid(inputFile) {
  // mmdc generates files in the same directory as input by default
  // Using the input filename as base: filename.md-1.png, filename.md-2.png, etc.
  const cmd = `mmdc -i "${inputFile}" -e png -b transparent`;

  console.log(`Running: ${cmd}`);
  try {
    execSync(cmd, { stdio: 'inherit' });
    return true;
  } catch (error) {
    console.error('Error running mmdc:', error.message);
    return false;
  }
}

// Find the nearest heading above a given position
function findHeading(content, position) {
  const beforeContent = content.substring(0, position);
  const lines = beforeContent.split('\n');

  // Search backwards for a heading
  for (let i = lines.length - 1; i >= 0; i--) {
    const line = lines[i].trim();
    const match = line.match(/^(#{1,6})\s+(.+)$/);
    if (match) {
      return match[2].trim();
    }
  }

  return 'Diagram';
}

// Find all mermaid blocks and their positions
function findMermaidBlocks(content) {
  const blocks = [];
  const regex = /```mermaid\n([\s\S]*?)```/g;
  let match;
  let index = 1;

  while ((match = regex.exec(content)) !== null) {
    const heading = findHeading(content, match.index);
    blocks.push({
      index: index++,
      start: match.index,
      end: match.index + match[0].length,
      heading: heading,
      content: match[0]
    });
  }

  return blocks;
}

// Insert image references before mermaid blocks
function insertImageRefs(content, inputFile, blocks) {
  if (blocks.length === 0) {
    console.log('No mermaid blocks found.');
    return content;
  }

  const basename = path.basename(inputFile);
  const dirname = path.dirname(inputFile);
  let result = content;
  let offset = 0;

  for (const block of blocks) {
    const imageName = `${basename}-${block.index}.png`;
    const imagePath = `./${imageName}`;
    const imageRef = `![${block.heading}](${imagePath})\n\n`;

    // Insert image reference before the mermaid block
    const insertPos = block.start + offset;
    result = result.slice(0, insertPos) + imageRef + result.slice(insertPos);
    offset += imageRef.length;

    console.log(`  ${block.index}. "${block.heading}" -> ${imageName}`);
  }

  return result;
}

// Main execution
function main() {
  const options = parseArgs();

  if (options.help) {
    showHelp();
    process.exit(0);
  }

  if (!options.inputFile) {
    console.error('Error: No input file specified');
    console.error('Run with --help for usage information');
    process.exit(1);
  }

  // Check dependencies
  if (!checkDependencies()) {
    console.error('Error: mmdc not found');
    console.error('Install with: npm install -g @mermaid-js/mermaid-cli');
    process.exit(1);
  }

  // Validate input file
  if (!fs.existsSync(options.inputFile)) {
    console.error(`Error: File not found: ${options.inputFile}`);
    process.exit(1);
  }

  const inputPath = path.resolve(options.inputFile);
  const content = fs.readFileSync(inputPath, 'utf8');

  console.log(`\nProcessing: ${inputPath}`);
  console.log('─'.repeat(60));

  // Find mermaid blocks
  const blocks = findMermaidBlocks(content);
  console.log(`Found ${blocks.length} mermaid block(s)\n`);

  if (blocks.length === 0) {
    console.log('Nothing to do.');
    process.exit(0);
  }

  // Run mmdc to generate images
  console.log('Generating PNG files...');
  if (!runMermaid(inputPath)) {
    process.exit(1);
  }

  // Insert image references
  console.log('\nInserting image references:');
  const newContent = insertImageRefs(content, inputPath, blocks);

  if (options.dryRun) {
    console.log('\n[DRY RUN] Would write updated content to:', inputPath);
    console.log('[DRY RUN] No changes made.');
    process.exit(0);
  }

  // Create backup
  if (!options.noBackup) {
    createBackup(inputPath);
  }

  // Write updated content
  fs.writeFileSync(inputPath, newContent, 'utf8');
  console.log(`✓ Updated: ${inputPath}`);
  console.log('\n✨ Done! Images embedded successfully.');
}

// Run
try {
  main();
} catch (error) {
  console.error('\nError:', error.message);
  process.exit(1);
}
